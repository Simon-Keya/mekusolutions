# Public
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Digits only, with country code and no + or spaces. Kenyan numbers are 254 followed by 9 digits (12 digits total).
# The contact form opens WhatsApp with the message pre-filled once this is set.
# Leave empty until the number is confirmed registered on WhatsApp (the form then falls back to email).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server only (never use NEXT_PUBLIC_ prefix)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=mekusolutions@gmail.com
ENQUIRY_FROM_EMAIL=
